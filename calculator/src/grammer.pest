Program = _{ SOI ~ Expr ~ (";" ~ Expr)* ~ ";"? ~ EOI }

Expr = { BinaryExpr | UnaryExpr | Term }

Term = { Int | Float | "(" ~ Expr ~ ")" }

UnaryExpr = { Operator ~ Term }

BinaryExpr = { (UnaryExpr | Term) ~ (Operator ~ Term)+ }

Int = @{ ASCII_DIGIT+ }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

Operator = { "+" | "-" | "*" | "/" }

Float = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
